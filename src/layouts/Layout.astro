---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Plot Atlas</title>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-20 px-5 py-5 sm:px-8">
      <nav aria-label="Menu des essais" class="mx-auto flex max-w-6xl items-center justify-between gap-6">
        <a href="/" class="font-display text-xl font-semibold tracking-tight text-white">Plot Atlas</a>
        <div class="flex items-center gap-2 rounded-full border border-white/30 bg-white/15 p-1 text-sm text-white backdrop-blur-md sm:gap-5 sm:px-2">
          <a href="/" class="rounded-full px-3 py-2 hover:bg-white/20 hover:text-white">Accueil</a>
          <a href="/simple" class="hidden rounded-full px-3 py-2 hover:bg-white/20 hover:text-white sm:block">Simple</a>
          <a href="/penguins" class="rounded-full px-3 py-2 hover:bg-white/20 hover:text-white">Penguins</a>
          <a href="/weather" class="rounded-full px-3 py-2 hover:bg-white/20 hover:text-white">Weather</a>
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
