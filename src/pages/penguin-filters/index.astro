---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main class="mx-auto max-w-5xl p-8">
    <nav aria-label="Navigation des essais" class="mb-8">
      <a href="/">Sommaire</a>
      <span aria-hidden="true"> / </span>
      <a href="/penguin-filters" aria-current="page">Penguin avec plusieurs filtres</a>
    </nav>

    <h1 class="text-2xl font-bold">Penguin avec plusieurs filtres</h1>

    <div class="mt-6 flex flex-wrap gap-4">
      <label for="species">
        Espèce
        <select name="species" id="species">
          <option value="">All species</option>
          <option value="Adelie">Adelie</option>
          <option value="Chinstrap">Chinstrap</option>
          <option value="Gentoo">Gentoo</option>
        </select>
      </label>

      <label for="island">
        Île
        <select name="island" id="island">
          <option value="">All islands</option>
          <option value="Biscoe">Biscoe</option>
          <option value="Dream">Dream</option>
          <option value="Torgersen">Torgersen</option>
        </select>
      </label>

      <label for="sex">
        Sexe
        <select name="sex" id="sex">
          <option value="">All sexes</option>
          <option value="MALE">MALE</option>
          <option value="FEMALE">FEMALE</option>
        </select>
      </label>
    </div>

    <div id="myplot" class="mt-6" aria-label="Graphique des manchots filtré"></div>
  </main>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../../assets/penguins.json";

  const selectSpecies = document.querySelector<HTMLSelectElement>("#species");
  const selectIsland = document.querySelector<HTMLSelectElement>("#island");
  const selectSex = document.querySelector<HTMLSelectElement>("#sex");

  function renderPlot() {
    const plotContainer = document.querySelector<HTMLDivElement>("#myplot");

    if (!selectSpecies || !selectIsland || !selectSex || !plotContainer) {
      return;
    }

    const species = selectSpecies.value;
    const island = selectIsland.value;
    const sex = selectSex.value;

    plotContainer.innerHTML = "";

    const plot = Plot.plot({
      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
          filter: (penguin) =>
            (!species || penguin.species === species) &&
            (!island || penguin.island === island) &&
            (!sex || penguin.sex === sex),
        }),
      ],
    });

    plotContainer.append(plot);
  }

  selectSpecies?.addEventListener("change", renderPlot);
  selectIsland?.addEventListener("change", renderPlot);
  selectSex?.addEventListener("change", renderPlot);
  renderPlot();
</script>