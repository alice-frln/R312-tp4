---
import Layout from "../../layouts/Layout.astro";
import weatherImage from "../../assets/weather_à1.jpg";
---

<Layout>
  <main class="mx-auto max-w-6xl px-6 pb-16 pt-28 sm:px-10">
    <section class="relative min-h-[25rem] overflow-hidden rounded-[2rem] bg-[#263b50] p-8 sm:p-12">
      <img src={weatherImage.src} alt="Ciel couvert et nuages de pluie" class="absolute inset-0 h-full w-full object-cover opacity-75" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#17283b] via-[#17283b]/55 to-transparent"></div>
      <div class="relative max-w-lg text-white">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-200">Collection 02</p>
        <h1 class="mt-4 font-display text-5xl leading-none sm:text-6xl">Weather</h1>
        <p class="mt-5 leading-7 text-slate-100">Lire les saisons dans les températures, les précipitations et les conditions observées.</p>
      </div>
    </section>

    <nav aria-label="Essais Weather" class="mt-10 grid gap-4 sm:grid-cols-2">
      <a href="/weather/simple" class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:-translate-y-1 hover:shadow-lg">
        <span class="text-sm font-semibold text-[#547b9e]">01</span><h2 class="mt-8 font-display text-2xl">Weather simple</h2><p class="mt-2 text-sm leading-6 text-slate-600">Visualiser les températures minimales et maximales.</p>
      </a>
      <a href="/weather-filter" class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:-translate-y-1 hover:shadow-lg">
        <span class="text-sm font-semibold text-[#087f8c]">02</span><h2 class="mt-8 font-display text-2xl">Weather avec filtres</h2><p class="mt-2 text-sm leading-6 text-slate-600">Explorer une ville ou un type de météo.</p>
      </a>
    </nav>
  </main>
</Layout>
