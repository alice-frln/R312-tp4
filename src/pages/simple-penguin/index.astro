---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main class="mx-auto max-w-5xl p-8">
    <nav aria-label="Navigation des essais" class="mb-8">
      <a href="/">Sommaire</a>
      <span aria-hidden="true"> / </span>
      <a href="/simple-penguin" aria-current="page">Simple Penguin</a>
    </nav>

    <h1 class="text-2xl font-bold">Simple Penguin</h1>
    <p class="mt-2">Graphique des manchots à partir du fichier JSON.</p>
    <div id="myplot" class="mt-6" aria-label="Graphique des manchots"></div>
  </main>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../../assets/penguins.json";

  const plot = Plot.plot({
    marks: [
      Plot.dot(penguins, {
        x: "culmen_length_mm",
        y: "culmen_depth_mm",
        stroke: "species",
      }),
    ],
  });
  const div = document.querySelector<HTMLDivElement>("#myplot");
  div?.append(plot);
</script>